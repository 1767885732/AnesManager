<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="SpecialCare" type="Com.MedicalSystem.Icu.Configurations.MedConfigurationClassArrayData, CommonLib, Version=1.0.3187.27057, Culture=neutral, PublicKeyToken=null" />
		<section name="reportViewerSettings" type="MedicalSystem.SmartReport.Viewer.Configuration.ReportViewerSection, MedicalSystem.SmartReport.Viewer"/>
		<section name="emrUploadSettings" type="Medicalsystem.ICU.Interface.Configuration.EmrUploadConfigurationSection, DataModelProxy"/>
		<section name="clientDataModule" type="Com.MedicalSystem.Icu.ClientLibrary.ClientDataModuleSettings, ClientLibrary"/>
    <section name="accessControlSettings" type="iMedical.AccessControl.Configuration.AccessControlSettingSection, iMedical.AccessControl"/>
		<sectionGroup name="FlowConfig">
			<section name="Variables" type="TreatmentFlowLibrary.ConfigSections.FlowVariableSection, TreatmentFlowLibrary"/>
			<section name="Sentences" type="TreatmentFlowLibrary.ConfigSections.FlowSentenceSection, TreatmentFlowLibrary"/>
			<section name="Functions" type="TreatmentFlowLibrary.ConfigSections.FlowFunctionSection, TreatmentFlowLibrary"/>
			<section name="SignCodes" type="TreatmentFlowLibrary.ConfigSections.FlowSignCodeSection, TreatmentFlowLibrary"/>
		</sectionGroup>
	</configSections>
  <accessControlSettings defaultProvider="OracleProvider">
    <providers>
      <clear />
      <add name="OracleProvider"
        type="iMedical.AccessControl.Provider.OracleProvider.OracleAccessControlProvider, iMedical.AccessControl"
        connectionStringName="ICU_Oracle"/>
    </providers>
    <userSettings tableName="WIS_PERM_USER" userIDColumnName="USER_ID" userNameColumnName="LOGIN_NAME" userPasswordColumnName="LOGIN_PWD">
      <extendInfos>
        <add name="USER_NAME" description="用户名" />
        <add name="DEPT_ID" description="部门ID"/>
        <add name="CREATE_DATE_TIME" dbType="Date" description="创建日期" />
        <add name="IS_VALID" description="是否启用"/>
        <add name="MEMO" description="备注"/>
      </extendInfos>
    </userSettings>
  </accessControlSettings>
	<configProtectedData>
		<providers>
			<add  name="MyUserDataProtectionConfigurationProvider" type="Com.MedicalSystem.Common.Utilities.MDSDUserDataProtectionConfigurationProvider, CommonLib" />
		</providers>
	</configProtectedData>
	<connectionStrings configProtectionProvider="MyUserDataProtectionConfigurationProvider">
  <EncryptedData></EncryptedData>
 </connectionStrings>
	<SpecialCare assemblyName="IcuApp" classNames="Com.MedicalSystem.Icu.XiangShanInOrOutPanel" />
	<reportViewerSettings>
		<reportViewers defaultConnectionStringName="ICU">
			<add title="自定义表单1" reportName="TestReport" reportBehavior="FirstCreatThenUpdate" storageLocation="Database" organization="00003100" />
			<add title="自定义表单2" reportName="TestReport1" reportBehavior="AlwaysCreateNew" storageLocation="Database"  organization="00003100" />
		</reportViewers>
	</reportViewerSettings>
	<emrUploadSettings  connectionStringName="ICU"  />
	<clientDataModule callType="Oracle" interFaceIP="" remotingUrl=""
  ClentID="" HospitalID="" />
	<FlowConfig>
		<Variables>
			<add key="自定义数据"  value="TreatmentFlowLibrary.XmlElements.Variables.CustomVar, TreatmentFlowLibrary"/>
			<add key="基础数据"  value="TreatmentFlowLibrary.XmlElements.Variables.BasicDataVar, TreatmentFlowLibrary"/>
			<add key="体征数据"  value="TreatmentFlowLibrary.XmlElements.Variables.SignVar, TreatmentFlowLibrary"/>
			<add key="出入量数据"  value="TreatmentFlowLibrary.XmlElements.Variables.InOrOutVar, TreatmentFlowLibrary"/>
      <add key="病人基本数据"  value="TreatmentFlowLibrary.XmlElements.Variables.PatientVar, TreatmentFlowLibrary"/>
      <add key="共享数据"  value="TreatmentFlowLibrary.XmlElements.Variables.SharedDataVar, TreatmentFlowLibrary"/>
		</Variables>
		<Sentences>
			<add key="workNode" value="TreatmentFlowLibrary.XmlElements.Sentences.WorkNode, TreatmentFlowLibrary"/>
			<add key="data" value="TreatmentFlowLibrary.XmlElements.Sentences.Data, TreatmentFlowLibrary"/>
			<add key="alert" value="TreatmentFlowLibrary.XmlElements.Sentences.Alert, TreatmentFlowLibrary"/>
			<add key="break" value="TreatmentFlowLibrary.XmlElements.Sentences.Break, TreatmentFlowLibrary"/>
			<add key="false" value="TreatmentFlowLibrary.XmlElements.Sentences.False, TreatmentFlowLibrary"/>
			<add key="goto" value="TreatmentFlowLibrary.XmlElements.Sentences.Goto, TreatmentFlowLibrary"/>
			<add key="if" value="TreatmentFlowLibrary.XmlElements.Sentences.If, TreatmentFlowLibrary"/>
			<add key="loop" value="TreatmentFlowLibrary.XmlElements.Sentences.Loop, TreatmentFlowLibrary"/>
			<add key="set" value="TreatmentFlowLibrary.XmlElements.Sentences.Set, TreatmentFlowLibrary"/>
			<add key="showWindow" value="TreatmentFlowLibrary.XmlElements.Sentences.ShowWindow, TreatmentFlowLibrary"/>
			<add key="saveData" value="TreatmentFlowLibrary.XmlElements.Sentences.SaveData, TreatmentFlowLibrary"/>
			<add key="subThread" value="TreatmentFlowLibrary.XmlElements.Sentences.SubThread, TreatmentFlowLibrary"/>
			<add key="threadContainer" value="TreatmentFlowLibrary.XmlElements.Sentences.ThreadContainer, TreatmentFlowLibrary"/>
			<add key="true" value="TreatmentFlowLibrary.XmlElements.Sentences.True, TreatmentFlowLibrary"/>
			<add key="frequency" value="TreatmentFlowLibrary.XmlElements.Sentences.Frequency, TreatmentFlowLibrary"/>
		</Sentences>
		<Functions>
			<add key="last" value="TreatmentFlowLibrary.Functions.LastFunction, TreatmentFlowLibrary" />
			<add key="prev" value="TreatmentFlowLibrary.Functions.PrevFunction, TreatmentFlowLibrary" />
			<add key="average" value="TreatmentFlowLibrary.Functions.AverageFunction, TreatmentFlowLibrary" />
			<add key="now" value="TreatmentFlowLibrary.Functions.NowFunction, TreatmentFlowLibrary" />
			<add key="getPatientInfo" value="TreatmentFlowLibrary.Functions.GetPatientInfoFunction, TreatmentFlowLibrary" />
			<add key="today" value="TreatmentFlowLibrary.Functions.TodayFunction, TreatmentFlowLibrary" />
			<add key="empty" value="TreatmentFlowLibrary.Functions.EmptyFunction, TreatmentFlowLibrary" />
			<add key="addDateTime" value="TreatmentFlowLibrary.Functions.AddDateTimeFunction, TreatmentFlowLibrary" />
			<add key="isNullOrEmpty" value="TreatmentFlowLibrary.Functions.IsNullOrEmptyFunction, TreatmentFlowLibrary" />
			<add key="getPartTime" value="TreatmentFlowLibrary.Functions.GetPartTimeFunction, TreatmentFlowLibrary" />
      <add key="minTimeValue" value="TreatmentFlowLibrary.Functions.MinTimeValueFunction, TreatmentFlowLibrary" />
      <add key="isVarTimedOut" value="TreatmentFlowLibrary.Functions.IsVarTimedOutFunction, TreatmentFlowLibrary" />
      <add key="isVarUsed" value="TreatmentFlowLibrary.Functions.IsVarUsedFunction, TreatmentFlowLibrary" />
			<add key="sumInOrOutValue" value="Com.MedicalSystem.Icu.FlowController.NanJingZhongDaYiYuan.Functions.SumInOrOutValueFunction, IcuApp" />
		</Functions>
		<SignCodes>
