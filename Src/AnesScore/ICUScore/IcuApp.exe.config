      <add key="血肌酐" value="肌酐"/>
      <add key="血尿素氮" value="尿素氮"/>
	  <add key="specialChart" value="CVP"/>
		</SignCodes>
	</FlowConfig>
	<appSettings>
		<add key="HospitalAbbreviation" value="DongFangGanDan" />
		<add key="Token" value="IsValided" />
		<add key="StartForm" value="MainFrm" />
		<add key="CurrentUsingConnectionStringName"  value="ICU"/>
		<add key="USER_NAME" value="SSCJ" />
		<add key="USER_ID" value="SSCJ" />
		<add key="CurrentSkinName" value="ExtendBlue"/>
	</appSettings>
</configuration>





