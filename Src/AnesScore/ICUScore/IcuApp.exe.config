      <add key="PH" value="9004"/>
      <add key="HCO3" value="9005"/>
      <add key="中心静脉压" value="09"/>
      <add key="MAP" value="9010"/>-->
      <!--中大-->
      <add key="血糖" value="08"/>
      <add key="血压high" value="04"/>
      <add key="血压Low" value="05"/>
      <add key="SvCO2" value="9011"/>
      <add key="乳酸" value="Lac"/>
      <add key="PaO2" value="pO2"/>
      <add key="PaCO2" value="pCO2"/>
      <add key="PH" value="pH"/>
      <add key="HCO3" value="HCO3"/>
      <add key="MAP" value="67"/>
